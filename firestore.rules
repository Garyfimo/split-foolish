rules_version = '2';

// SplitFoolish Firestore security rules.
//
// Deploy with `firebase deploy --only firestore:rules` from this directory. The rules enforce
// what the client-side UI also presents, but live server-side so a compromised or rebuilt client
// can't bypass them (defence in depth).
//
// Model recap:
//   /users/{uid}               — canonical user record (own-user read+write).
//   /users_by_email/{email}    — reverse index so other users can find you by email.
//   /groups/{groupId}          — multi-member group; members[] lists uid+name, memberUids[] is
//                                the flat uid list used for array-contains queries.
//   /groups/{groupId}/expenses/{expenseId}
//                              — per-expense docs. createdByUid is pinned at creation and used
//                                to enforce the "only the creator can delete it" rule.
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed-in state guard. Used everywhere; rules without `isSignedIn()` would allow anonymous
    // reads, and Firestore defaults to open-unless-rules-say-otherwise once you deploy any rules.
    function isSignedIn() {
      return request.auth != null;
    }

    // Users directory: each account owns its own /users/{uid} doc. Any signed-in user can read
    // another user's doc so we can show display names in group member lists. Nobody else can
    // write to it — prevents impersonation.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Email reverse index. Any signed-in user can read (to look up email → uid during
    // "Add member by email"), but only the owning user can write their own pointer.
    // Clients derive the document id by lowercasing + trimming the email before lookup.
    match /users_by_email/{emailKey} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
    }

    // Groups: only accessible to members. On create we additionally require the caller to be
    // the declared creator AND to be in the initial memberUids list (prevents creating a group
    // owned by someone else, or a group with no permitted writers). Reads and updates require
    // the caller to be in the current memberUids list.
    match /groups/{groupId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.memberUids;

      allow create: if isSignedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;

      allow update: if isSignedIn()
        && request.auth.uid in resource.data.memberUids;

      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.memberUids;

      // Expenses: readable + writable by any group member. Delete is restricted to the user who
      // originally created the expense (resource.data.createdByUid is the server-persisted field
      // — can't be swapped at request time by a compromised client, so this check is reliable).
      match /expenses/{expenseId} {
        function groupData() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }
        function isMember() {
          return isSignedIn() && request.auth.uid in groupData().memberUids;
        }

        allow read: if isMember();

        allow create: if isMember()
          && request.resource.data.createdByUid == request.auth.uid;

        allow update: if isMember();

        allow delete: if isMember()
          && request.auth.uid == resource.data.createdByUid;
      }
    }
  }
}
